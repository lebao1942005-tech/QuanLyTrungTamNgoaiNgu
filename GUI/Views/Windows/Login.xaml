<Window x:Class="GUI.Views.Windows.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Đăng Nhập"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        FontFamily="Roboto"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Width="900" Height="650">

    <Window.Resources>

        <!-- Nút điều khiển cửa sổ -->
        <Style TargetType="Button" x:Key="WindowControlButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E5E5E5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        
        <Style TargetType="Button" x:Key="MaximizeButtonStyle"
               BasedOn="{StaticResource WindowControlButton}">
            <Setter Property="Content" Value="&#xE922;"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="Maximized">
                    <Setter Property="Content" Value="&#xE923;"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <!-- NỀN BO GÓC -->
    <Border CornerRadius="12"
            Background="White"
            Padding="0"
            SnapsToDevicePixels="True">

        <Grid>

            <!-- Thanh điều khiển cửa sổ -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,5,5,0">

                <Button Content="&#xE921;"
                        Style="{StaticResource WindowControlButton}"
                        Click="MinimizeButton_Click"/>

                <Button Style="{StaticResource MaximizeButtonStyle}"
                        Click="MaximizeButton_Click"/>

                <Button Content="&#xE8BB;"
                        Style="{StaticResource WindowControlButton}"
                        Click="CloseButton_Click"/>
            </StackPanel>

            <!-- Form đăng nhập -->
            <Border Background="White" 
                    Width="350" 
                    Padding="30" 
                    CornerRadius="10" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center">

                <Border.Effect>
                    <DropShadowEffect ShadowDepth="4" Color="#AAAAAA" Opacity="0.3" BlurRadius="15"/>
                </Border.Effect>

                <StackPanel VerticalAlignment="Center">

                    <!-- LOGO ĐƠN GIẢN -->
                    <TextBlock Text="LOGO"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#3B82F6"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Đăng Nhập"
                               FontSize="24"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,5" />

                    <TextBlock Text="Chào mừng trở lại! Vui lòng nhập thông tin của bạn." 
                               FontSize="12" 
                               Foreground="Gray" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,20" />

                    <!-- Vai trò -->
                    <Label Content="Vai trò" FontSize="13" FontWeight="Medium"/>
                    <ComboBox x:Name="RoleComboBox" 
                              Padding="10,8" 
                              BorderThickness="1" 
                              BorderBrush="LightGray" 
                              Margin="0,0,0,15">
                        <ComboBoxItem IsSelected="True" IsEnabled="False" Content="Chọn vai trò của bạn"/>
                        <ComboBoxItem Content="Admin" />
                        <ComboBoxItem Content="Giáo viên" />
                    </ComboBox>

                    <!-- Email -->
                    <Label Content="Email" FontSize="13" FontWeight="Medium"/>
                    <TextBox x:Name="EmailTextBox" 
                             Padding="10,8" 
                             BorderThickness="1" 
                             BorderBrush="LightGray" 
                             Margin="0,0,0,15"
                             Text="admin@example.com"/>

                    <!-- Password -->
                    <Label Content="Mật khẩu" FontSize="13" FontWeight="Medium"/>
                    <PasswordBox x:Name="PasswordBox" 
                                 Padding="10,8" 
                                 BorderThickness="1" 
                                 BorderBrush="LightGray" 
                                 Margin="0,0,0,15"/>

                    <!-- Remember - Forgot -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Content="Ghi nhớ tôi"/>

                        <TextBlock Grid.Column="1" HorizontalAlignment="Right">
                            <Hyperlink Foreground="#3B82F6">Quên mật khẩu?</Hyperlink>
                        </TextBlock>
                    </Grid>

                    <!-- Login Button -->
                    <Button Content="Đăng Nhập"
                            Background="#3B82F6"
                            Foreground="White"
                            Padding="12"
                            FontSize="14"
                            BorderThickness="0"
                            Click="LoginButton_Click"/>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>