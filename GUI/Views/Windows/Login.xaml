<Window x:Class="GUI.Views.Windows.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Đăng Nhập"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        FontFamily="Roboto"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Width="450" Height="650">

    <Window.Resources>
        <!-- Màu chủ đạo (Giữ màu xanh sáng của trang Login cũ) -->
        <SolidColorBrush x:Key="PrimaryBlue" Color="#3B82F6"/>
        <SolidColorBrush x:Key="GrayText" Color="#6B7280"/>

        <!-- Style nút điều khiển cửa sổ -->
        <Style TargetType="Button" x:Key="WindowControlButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E5E5E5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style nút Phóng to/Thu nhỏ -->
        <Style TargetType="Button" x:Key="MaximizeButtonStyle" BasedOn="{StaticResource WindowControlButton}">
            <Setter Property="Content" Value="&#xE922;"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                    <Setter Property="Content" Value="&#xE923;"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style TextBox/PasswordBox bo góc -->
        <Style TargetType="Control" x:Key="InputBoxStyle">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#A5B4FC"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- KHUNG CHÍNH BO GÓC (Giống ResetPasswordWindow) -->
    <Border Background="White" CornerRadius="20" BorderBrush="#E5E7EB" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.1" Color="Gray"/>
        </Border.Effect>

        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header Controls -->
                <RowDefinition Height="*"/>
                <!-- Login Form -->
            </Grid.RowDefinitions>

            <!-- 1. Header: Window Controls (Góc phải trên) -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="&#xE713;" 
                        Style="{StaticResource WindowControlButton}" 
                        Command="{Binding OpenConfigCommand}" 
                        ToolTip="Cấu hình kết nối Database"
                        Margin="0,0,10,0"/>
                
                <Button Content="&#xE921;" Style="{StaticResource WindowControlButton}" Click="MinimizeButton_Click" ToolTip="Thu nhỏ"/>
                <Button Style="{StaticResource MaximizeButtonStyle}" Click="MaximizeButton_Click" ToolTip="Phóng to"/>
                <Button Content="&#xE8BB;" Style="{StaticResource WindowControlButton}" Click="CloseButton_Click" ToolTip="Đóng" Foreground="#EF4444"/>
            </StackPanel>

            <!-- 2. Main Content (Căn giữa) -->
            <!-- THÊM Width="360" để cố định chiều rộng form, tránh bị giãn khi phóng to -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Width="360">

                <!-- LOGO -->
                <TextBlock Text="Star Edu"
                           FontSize="36"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBlue}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>

                <TextBlock Text="Đăng Nhập"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#111827"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,5" />

                <TextBlock Text="Chào mừng trở lại! Vui lòng nhập thông tin của bạn." 
                           FontSize="14" 
                           Foreground="{StaticResource GrayText}" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,30" />

                <!-- Vai trò -->
                <Label Content="Vai trò" FontSize="13" FontWeight="SemiBold" Foreground="#374151"/>
                <ComboBox x:Name="RoleComboBox" 
                          Padding="10,8" 
                          BorderThickness="1" 
                          BorderBrush="LightGray" 
                          Background="White"
                          Margin="0,0,0,15"
                          Height="40"
                          SelectedValuePath="Content"
                          SelectedValue="{Binding SelectedRole, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}">

                    <ComboBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </ComboBox.Resources>

                    <ComboBoxItem IsSelected="True" IsEnabled="False" Content="Chọn vai trò của bạn"/>
                    <ComboBoxItem Content="Admin" />
                    <ComboBoxItem Content="Giáo viên" />
                </ComboBox>

                <!-- Email -->
                <Label Content="Email" FontSize="13" FontWeight="SemiBold" Foreground="#374151"/>
                <TextBox x:Name="EmailTextBox" 
                         Style="{StaticResource InputBoxStyle}"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Password -->
                <Label Content="Mật khẩu" FontSize="13" FontWeight="SemiBold" Foreground="#374151"/>
                <PasswordBox x:Name="PasswordBox" 
                             Style="{StaticResource InputBoxStyle}"/>

                <!-- Remember - Forgot -->
                <Grid Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    

                    <TextBlock Grid.Column="1" HorizontalAlignment="Right">
                        <Hyperlink Foreground="{StaticResource PrimaryBlue}" TextDecorations="None" Click="ForgotPassword_Click" Cursor="Hand">
                            Quên mật khẩu?
                        </Hyperlink>
                    </TextBlock>
                </Grid>

                <!-- Login Button -->
                <Button Content="Đăng Nhập"
                        Background="{StaticResource PrimaryBlue}"
                        Foreground="White"
                        Height="50"
                        FontSize="16"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="LoginButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </Grid>
    </Border>
</Window>