<Window x:Class="GUI.Views.Windows.AdminMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        
        xmlns:shared="clr-namespace:GUI.Views.Shared"
        xmlns:viewmodels="clr-namespace:GUI.ViewModels"
        
        xmlns:dashboard="clr-namespace:GUI.Views.Pages.Dashboard"
        xmlns:student="clr-namespace:GUI.Views.Pages.StudentManagement"
        xmlns:teacher="clr-namespace:GUI.Views.Pages.TeacherManagement"
        xmlns:class="clr-namespace:GUI.Views.Pages.ClassManagement"
        xmlns:register="clr-namespace:GUI.Views.Pages.RegistrationManagement"
        xmlns:course="clr-namespace:GUI.Views.Pages.CourseManagement"
        xmlns:tuition="clr-namespace:GUI.Views.Pages.TuitionManagement"
        
        mc:Ignorable="d"
        Title="Admin Center - Management System" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen" 
        Background="#F1F5F9"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- DATA TEMPLATES -->
        <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
            <dashboard:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:StudentManagementViewModel}">
            <student:StudentManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:TeacherManagementViewModel}">
            <teacher:TeacherManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ClassManagementViewModel}">
            <class:ClassManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:RegistrationManagementViewModel}">
            <register:RegistrationManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:CourseManagementViewModel}">
            <course:CourseManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:TuitionViewModel}">
            <tuition:TuitionManagementView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- === 1. SIDEBAR AREA === -->
        <Grid Grid.Column="0" Panel.ZIndex="100">

            <!-- Sidebar Lớn: Hiện khi IsSidebarOpen = True -->
            <shared:SidebarView 
                Visibility="{Binding IsSidebarOpen, Converter={StaticResource BoolToVis}}"/>

            <!-- Sidebar Nhỏ: Dùng Style để xử lý logic ngược -->
            <!-- ĐÃ SỬA: Xóa thuộc tính Visibility trực tiếp ở đây -->
            <shared:SmallSidebarView>
                <shared:SmallSidebarView.Style>
                    <Style TargetType="UserControl">
                        <!-- Mặc định là Hiện (cho trường hợp False) -->
                        <Setter Property="Visibility" Value="Visible"/>

                        <Style.Triggers>
                            <!-- Khi SidebarOpen = True (Đang mở to) -> Thì ẨN cái nhỏ đi -->
                            <DataTrigger Binding="{Binding IsSidebarOpen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </shared:SmallSidebarView.Style>
            </shared:SmallSidebarView>
        </Grid>

        <!-- === 2. MAIN CONTENT AREA === -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <shared:HeaderView Grid.Row="0"/>

            <!-- Nội dung thay đổi -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" Margin="0"/>
        </Grid>
    </Grid>
</Window>