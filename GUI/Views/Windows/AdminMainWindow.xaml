<Window x:Class="GUI.Views.Windows.AdminMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        
        xmlns:shared="clr-namespace:GUI.Views.Shared"
        xmlns:viewModel="clr-namespace:GUI.ViewModels"
        
        xmlns:student="clr-namespace:GUI.Views.Pages.StudentManagement"
        xmlns:teacher="clr-namespace:GUI.Views.Pages.TeacherManagement" 
        xmlns:class="clr-namespace:GUI.Views.Pages.ClassManagement"
        xmlns:register="clr-namespace:GUI.Views.Pages.RegistrationManagement"
        xmlns:course="clr-namespace:GUI.Views.Pages.CourseManagement"

        mc:Ignorable="d"
        Title="Quản trị trung tâm" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen" Background="#FFFFFF">

    <Window.Resources>
        <!-- DataTemplate: Mapping giữa ViewModel và View -->

        <!-- 1. Student -->
        <DataTemplate DataType="{x:Type viewModel:StudentManagementViewModel}">
            <student:StudentManagementView/>
        </DataTemplate>

        <!-- 2. Teacher (ĐÃ SỬA: Dùng prefix 'teacher' đã khai báo ở trên) -->
        <DataTemplate DataType="{x:Type viewModel:TeacherManagementViewModel}">
            <teacher:TeacherManagementView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModel:ClassManagementViewModel}">
            <class:ClassManagementView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModel:RegistrationManagementViewModel}">
            <register:RegistrationManagementView/>
        </DataTemplate>


        <DataTemplate DataType="{x:Type viewModel:CourseManagementViewModel}">
            <course:CourseManagementView/>
        </DataTemplate>


    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <shared:SidebarView x:Name="FullSidebar" Grid.Column="0" Visibility="Visible"/>
        <shared:SmallSidebarView x:Name="SmallSidebar" Grid.Column="0" Visibility="Collapsed"/>

        <!-- Main Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <shared:HeaderView Grid.Row="0" ToggleSidebarClick="HeaderView_ToggleSidebarClick"/>

            <!-- Vùng hiển thị nội dung động -->
            <ContentControl x:Name="MainContent"
                            Grid.Row="1"
                            Content="{Binding CurrentViewModel}" />
        </Grid>
    </Grid>
</Window>