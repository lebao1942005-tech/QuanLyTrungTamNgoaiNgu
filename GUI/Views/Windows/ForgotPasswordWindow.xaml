<Window x:Class="GUI.Views.Windows.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Quên Mật Khẩu"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        FontFamily="Roboto"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Width="450" Height="600">

    <Window.Resources>
        <!-- Màu chủ đạo -->
        <SolidColorBrush x:Key="PrimaryBlue" Color="#3B82F6"/>
        <SolidColorBrush x:Key="GrayText" Color="#6B7280"/>

        <!-- Style nút điều khiển cửa sổ -->
        <Style TargetType="Button" x:Key="WindowControlButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E5E5E5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style nút Phóng to/Thu nhỏ -->
        <Style TargetType="Button" x:Key="MaximizeButtonStyle" BasedOn="{StaticResource WindowControlButton}">
            <Setter Property="Content" Value="&#xE922;"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                    <Setter Property="Content" Value="&#xE923;"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style TextBox bo góc -->
        <Style TargetType="TextBox" x:Key="InputBoxStyle">
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#A5B4FC"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- KHUNG CHÍNH BO GÓC (Giống LoginWindow mới) -->
    <Border Background="White" CornerRadius="20" BorderBrush="#E5E7EB" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.1" Color="Gray"/>
        </Border.Effect>

        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header Controls -->
                <RowDefinition Height="*"/>
                <!-- Form -->
            </Grid.RowDefinitions>

            <!-- 1. Header: Window Controls (Góc phải trên) -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="&#xE921;" Style="{StaticResource WindowControlButton}" Click="MinimizeButton_Click" ToolTip="Thu nhỏ"/>
                <Button Style="{StaticResource MaximizeButtonStyle}" Click="MaximizeButton_Click" ToolTip="Phóng to"/>
                <Button Content="&#xE8BB;" Style="{StaticResource WindowControlButton}" Click="CloseButton_Click" ToolTip="Đóng" Foreground="#EF4444"/>
            </StackPanel>

            <!-- 2. Main Content (Căn giữa) -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Width="360">

                <!-- Icon Ổ khóa (Trang trí) -->
                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="40" Foreground="{StaticResource PrimaryBlue}" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                <!-- Tiêu đề -->
                <TextBlock Text="Quên Mật Khẩu?" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <!-- Hướng dẫn -->
                <TextBlock Text="Đừng lo lắng! Vui lòng nhập email đã đăng ký của bạn, chúng tôi sẽ gửi mã OTP để xác minh." 
                           FontSize="13" Foreground="{StaticResource GrayText}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,30" LineHeight="20"/>

                <!-- Input Email -->
                <Label Content="Email xác minh" FontSize="13" FontWeight="SemiBold" Foreground="#374151"/>

                <TextBox x:Name="EmailRecoveryTextBox" 
                         Style="{StaticResource InputBoxStyle}"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Button Gửi OTP -->
                <Button Content="Gửi mã OTP" 
                        Height="45" 
                        Background="{StaticResource PrimaryBlue}" 
                        Foreground="White" 
                        FontSize="14" 
                        FontWeight="SemiBold" 
                        BorderThickness="0" 
                        Cursor="Hand" 
                        Command="{Binding SendCodeCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Button Quay lại đăng nhập -->
                <Button Content="Quay lại Đăng nhập" 
                        Background="Transparent" 
                        Foreground="{StaticResource GrayText}" 
                        Margin="0,20,0,0" 
                        BorderThickness="0" 
                        Cursor="Hand" 
                        Command="{Binding BackToLoginCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" TextDecorations="None">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBlue}"/>
                                                <Setter Property="TextDecorations" Value="Underline"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </Grid>
    </Border>
</Window>