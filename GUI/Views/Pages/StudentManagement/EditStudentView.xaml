<UserControl x:Class="GUI.Views.Pages.StudentManagement.EditStudentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="535" Height="Auto" 
             Background="Transparent" FontFamily="Segoe UI">

    <UserControl.Resources>
        <!-- Màu chủ đạo (có thể đổi sang màu cam/vàng để phân biệt với Thêm nếu thích) -->
        <SolidColorBrush x:Key="PrimaryBlue" Color="#1D4ED8"/>

        <!-- Style TextBox chung -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Style cho TextBox bị khóa (Read-only) -->
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="#F3F4F6"/>
                    <Setter Property="Foreground" Value="#6B7280"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Border Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.2" Color="Gray"/>
        </Border.Effect>

        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Cập nhật thông tin học viên" FontSize="20" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center"/>

                <!-- Nút Đóng (X) -->
                <Button Command="{Binding CancelEditStudentCommand}"
                        Content="&#xE711;" FontFamily="Segoe MDL2 Assets" 
                        FontSize="12" Width="30" Height="30" 
                        Background="Transparent" BorderThickness="0" 
                        HorizontalAlignment="Right" Cursor="Hand"/>
            </Grid>

            <!-- Form Fields -->
            <StackPanel Grid.Row="1" VerticalAlignment="Top">

                <!-- Mã học viên (Chỉ đọc) -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Mã HV" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#374151"/>
                        <TextBox Text="{Binding EditStudentId, Mode=OneWay}" IsReadOnly="True" FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Họ và tên" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#374151"/>
                        <!-- Binding EditStudentName -->
                        <TextBox Text="{Binding EditStudentName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Số điện thoại" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#374151"/>
                        <!-- Binding EditStudentPhone -->
                        <TextBox Text="{Binding EditStudentPhone, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Ngày sinh" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#374151"/>
                        <!-- Binding EditStudentBirthday -->
                        <DatePicker SelectedDate="{Binding EditStudentBirthday, UpdateSourceTrigger=PropertyChanged}" 
                                    Height="38" VerticalContentAlignment="Center" 
                                    BorderBrush="#E5E7EB" BorderThickness="1" Background="White"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Email" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#374151"/>
                <!-- Binding EditStudentEmail -->
                <TextBox Text="{Binding EditStudentEmail, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Note nhỏ -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="Vui lòng kiểm tra kỹ thông tin trước khi cập nhật." Foreground="#6B7280" FontSize="12" FontStyle="Italic"/>
                </StackPanel>
            </StackPanel>

            <!-- Footer Buttons -->
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Nút Hủy -->
                <Button Content="Hủy bỏ" Command="{Binding CancelEditStudentCommand}"
                        Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Foreground="#374151"
                        Height="40" Margin="0,0,5,0" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Nút Lưu thay đổi (ConfirmEditStudentCommand) -->
                <Button Content="Lưu thay đổi" Command="{Binding ConfirmEditStudentCommand}" Grid.Column="1"
                        Background="{StaticResource PrimaryBlue}" Foreground="White" BorderThickness="0"
                        Height="40" Margin="5,0,0,0" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>