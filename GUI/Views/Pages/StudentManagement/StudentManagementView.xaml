<UserControl x:Class="GUI.Views.Pages.StudentManagement.StudentManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GUI.Views.Pages.StudentManagement"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200"
             Background="#F3F4F6" FontFamily="Segoe UI">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <SolidColorBrush x:Key="PrimaryBlue" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="LightBlueBg" Color="#DBEAFE"/>
        <SolidColorBrush x:Key="GreenText" Color="#059669"/>
        <SolidColorBrush x:Key="GreenBg" Color="#D1FAE5"/>
        <SolidColorBrush x:Key="PinkText" Color="#DB2777"/>
        <SolidColorBrush x:Key="PinkBg" Color="#FCE7F6"/>
        <SolidColorBrush x:Key="YellowText" Color="#D97706"/>
        <SolidColorBrush x:Key="YellowBg" Color="#FEF3C7"/>
        <SolidColorBrush x:Key="RedText" Color="#DC2626"/>
        <SolidColorBrush x:Key="OrangeBg" Color="#F97316"/>
        <SolidColorBrush x:Key="GrayText" Color="#4B5563"/>
        <SolidColorBrush x:Key="GrayBg" Color="#E5E7EB"/>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                                <ContentPresenter/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GridActionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="15">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" 
                                       FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>


    <Grid>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Danh sách học viên" FontSize="24" FontWeight="Bold" 
                       Foreground="#111827" Margin="0,0,0,20"/>

            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">


                    <Border Margin="10,0,0,0" Width="300" Height="40" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" 
                   VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#9CA3AF"/>

                            <TextBox VerticalAlignment="Center" Margin="35,0,10,0" BorderThickness="0"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="2">
                    <Button Content="Thêm học viên" Tag="&#xE710;" Background="{StaticResource PrimaryBlue}" Foreground="White"
                            Style="{StaticResource ToolbarButtonStyle}" Command="{Binding AddStudentCommand}"/>

                    <Button Content="Xuất file" 
                            Tag="&#xE78C;" 
                            Background="{StaticResource OrangeBg}" 
                            Foreground="White"
                            Style="{StaticResource ToolbarButtonStyle}"
        
                            Command="{Binding ExportToPdfCommand}"/>
                </StackPanel>
            </Grid>

            <!-- Thêm AlternationCount -->
            <Border Grid.Row="2" Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Padding="0">
                <DataGrid ItemsSource="{Binding Students}" AutoGenerateColumns="False"
                          CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="0"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F3F4F6"
                          Background="White" RowHeight="70"
                          AlternationCount="10000">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource PrimaryBlue}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Padding" Value="15,12"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>

                        <!-- Cột STT Mới -->
                        <DataGridTemplateColumn Header="STT" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=DataGridRow}}" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center" 
                                               FontWeight="SemiBold" Foreground="#6B7280"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="THÔNG TIN" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- Thêm VerticalAlignment="Center" -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel Margin="5,0,0,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding StudentID}" FontSize="12" Foreground="#6B7280"/>
                                            <TextBlock Text="{Binding Birthday, StringFormat='dd/MM/yyyy'}" FontSize="12" Foreground="#6B7280"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="LIÊN HỆ" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- Thêm VerticalAlignment="Center" -->
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Phone, StringFormat='Điện thoại: {0}'}"/>
                                        <TextBlock Text="{Binding Email, StringFormat='Email: {0}'}" FontSize="12"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="TRẠNG THÁI" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="StatusText" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="1">
                                            <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource GrayText}"/>
                                            <Setter TargetName="StatusText" Property="Text" Value="Không lớp"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="2">
                                            <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource PrimaryBlue}"/>
                                            <Setter TargetName="StatusText" Property="Text" Value="Đang học"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="CHỨC NĂNG" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- Thêm VerticalAlignment="Center" -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                        <Button Content="&#xE70F;" 
                                                Style="{StaticResource GridActionButton}"
                                                ToolTip="Chỉnh sửa"
                                                Command="{Binding DataContext.EditStudentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>

                                        <Button Content="&#xE74D;" 
                                                Style="{StaticResource GridActionButton}"
                                                ToolTip="Xóa"
                                                Command="{Binding DataContext.RequestDeleteStudentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>


        <Border Background="#80000000">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <!-- Hiện khi popup THÊM mở -->
                        <DataTrigger Binding="{Binding IsAddStudentPopupVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <!-- Hiện khi popup XÓA mở -->
                        <DataTrigger Binding="{Binding IsDeleteStudentPopupVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <!-- Hiện khi popup SỬA mở (MỚI THÊM) -->
                        <DataTrigger Binding="{Binding IsEditStudentPopupVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <local:AddStudentView
            Visibility="{Binding IsAddStudentPopupVisible, Converter={StaticResource BoolToVis}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            DataContext="{Binding}"/>


        <local:DeleteStudentView
            Visibility="{Binding IsDeleteStudentPopupVisible, Converter={StaticResource BoolToVis}}"
            HorizontalAlignment="Center" VerticalAlignment="Center" DataContext="{Binding}"/>


        <local:EditStudentView 
            Visibility="{Binding IsEditStudentPopupVisible, Converter={StaticResource BoolToVis}}"
            HorizontalAlignment="Center" VerticalAlignment="Center" DataContext="{Binding}"/>


    </Grid>

</UserControl>