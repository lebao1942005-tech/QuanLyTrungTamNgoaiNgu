<UserControl x:Class="GUI.Views.Pages.StudentManagement.DeleteStudentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="212" d:DesignWidth="446"
             Width="446" Height="212"
             Background="Transparent" FontFamily="Segoe UI">

    <UserControl.Resources>
        <!-- Style cho nút đóng (dấu X) -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="4">
                            <Path Data="M6 18L18 6M6 6L18 18"
                                  Stroke="Black" Opacity="0.34"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Stretch="Uniform"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho nút Xác nhận (Màu đỏ nhạt) -->
        <Style x:Key="ConfirmButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0FE00000"/>
            <!-- Red with very low opacity -->
            <Setter Property="Foreground" Value="#E00000"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <!-- Segoe UI thường cần SemiBold để nổi bật nút -->
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1FE00000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border CornerRadius="14" Background="White">
        <!-- Hiệu ứng đổ bóng -->
        <Border.Effect>
            <DropShadowEffect ShadowDepth="1" Direction="315" Color="Black" Opacity="0.14" BlurRadius="5.4"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Title + Close -->
                <RowDefinition Height="*"/>
                <!-- Message -->
                <RowDefinition Height="Auto"/>
                <!-- Button -->
            </Grid.RowDefinitions>

            <!-- Close Button (Góc trên phải) -->
            <Button Style="{StaticResource CloseButtonStyle}"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,15,15,0"
                    Command="{Binding CancelCommand}"/>

            <!-- Title -->
            <TextBlock Grid.Row="0" Text="Xóa học viên" 
                       FontSize="20" FontWeight="SemiBold" Foreground="#8A8A8A" 
                       Margin="27,35,0,0"/>

            <!-- Content Message -->
            <TextBlock Grid.Row="1" 
                       Text="Bạn có chắc chắn muốn xóa học viên này không?&#x0a;Hành động này không thể hoàn tác." 
                       FontSize="13" Foreground="#6F6F6F" 
                       TextAlignment="Center" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" 
                       TextWrapping="Wrap" Margin="20,0"/>

            <!-- Confirm Button -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,30,25">
                <!-- Nút Hủy -->
                <Button Content="Hủy bỏ" Height="37" Margin="0,0,10,0"
                        Background="Transparent" BorderThickness="0" Foreground="#6F6F6F" Cursor="Hand"
                        Command="{Binding CancelCommand}"/>

                <!-- Nút Xác nhận Xóa -->
                <Button Content="Xác nhận" Width="88" Height="37"
                        Style="{StaticResource ConfirmButtonStyle}"
                        Command="{Binding ConfirmCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>