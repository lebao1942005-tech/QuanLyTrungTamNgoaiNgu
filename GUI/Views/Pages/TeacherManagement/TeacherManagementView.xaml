<UserControl x:Class="GUI.Views.Pages.TeacherManagement.TeacherManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:GUI.Views.Pages.TeacherManagement"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200"
             Background="#F3F4F6" FontFamily="Segoe UI">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="OrangeBg" Color="#F97316"/>
        <SolidColorBrush x:Key="GrayText" Color="#4B5563"/>
        <SolidColorBrush x:Key="GrayBg" Color="#E5E7EB"/>

        <!-- Toolbar Button Style -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                                <ContentPresenter/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Action Button -->
        <Style x:Key="GridActionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="15">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" 
                                       FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- GRID TỔNG (ROOT) - Không có Margin để Popup phủ kín -->
    <Grid>

        <!-- GRID NỘI DUNG CHÍNH - Có Margin 20 -->
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Text="Danh sách giáo viên" FontSize="24" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,20"/>

            <!-- Toolbar -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <ComboBox Width="200" SelectedIndex="0" Margin="0,0,10,0" Height="40" Padding="10,0" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Tất cả bộ môn"/>
                        <ComboBoxItem Content="Tiếng Anh"/>
                        <ComboBoxItem Content="Tin học"/>
                    </ComboBox>
                    <Border Width="300" Height="40" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#9CA3AF"/>
                            <TextBox VerticalAlignment="Center" Margin="35,0,10,0" BorderThickness="0" Background="Transparent" Text="Tìm kiếm"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" Grid.Column="1">
                    <Button Content="Thêm giáo viên" Tag="&#xE710;"
                            Background="{StaticResource PrimaryBlue}" Foreground="White"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding OpenAddTeacherPopupCommand}"/>
                    <Button Content="Xuất file" Tag="&#xE78C;" Background="{StaticResource OrangeBg}" Foreground="White"
                            Style="{StaticResource ToolbarButtonStyle}"/>
                </StackPanel>
            </Grid>

            <!-- DataGrid -->
            <!-- Thêm AlternationCount để hỗ trợ hiển thị STT -->
            <Border Grid.Row="2" Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Padding="0">
                <DataGrid ItemsSource="{Binding Teachers}" AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" BorderThickness="0"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F3F4F6"
                          Background="White" RowHeight="70"
                          AlternationCount="10000">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource PrimaryBlue}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Padding" Value="15,12"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <!-- STT (Mới thêm) -->
                        <DataGridTemplateColumn Header="STT" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=DataGridRow}}" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center" 
                                               FontWeight="SemiBold" Foreground="#6B7280"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Thông tin -->
                        <DataGridTemplateColumn Header="THÔNG TIN" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- Đã thêm VerticalAlignment="Center" -->
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding TeacherID}" FontSize="12" Foreground="#6B7280"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Liên hệ -->
                        <DataGridTemplateColumn Header="LIÊN HỆ" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- Đã thêm VerticalAlignment="Center" -->
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Phone, StringFormat='Điện thoại: {0}'}"/>
                                        <TextBlock Text="{Binding Email, StringFormat='Email: {0}'}" FontSize="12"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Bộ môn -->
                        <DataGridTemplateColumn Header="BỘ MÔN" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#DBEAFE" CornerRadius="12" Padding="12,6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Subject}" Foreground="#1D4ED8" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Chức năng -->
                        <DataGridTemplateColumn Header="CHỨC NĂNG" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="&#xE70F;"
                                                Style="{StaticResource GridActionButton}"
                                                ToolTip="Chỉnh sửa"
                                                Command="{Binding DataContext.EditTeacherCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="&#xE74D;"
                                                Style="{StaticResource GridActionButton}"
                                                ToolTip="Xóa"
                                                Command="{Binding DataContext.RequestDeleteTeacherCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- PHẦN POPUP & OVERLAY - Nằm ngoài Grid nội dung để phủ toàn bộ -->

        <!-- Overlay -->
        <Border Background="#80000000">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAddTeacherPopupVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsDeleteTeacherPopupVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <!-- Popups -->
        <local:AddTeacherView
            Visibility="{Binding IsAddTeacherPopupVisible, Converter={StaticResource BoolToVis}}"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            DataContext="{Binding}"/>

        <local:DeleteTeacherView
            Visibility="{Binding IsDeleteTeacherPopupVisible, Converter={StaticResource BoolToVis}}"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            DataContext="{Binding}"/>


        <local:EditTeacherView
            Visibility="{Binding IsEditTeacherPopupVisible, Converter={StaticResource BoolToVis}}"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            DataContext="{Binding}"/>

    </Grid>
</UserControl>