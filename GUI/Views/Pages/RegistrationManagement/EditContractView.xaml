<UserControl x:Class="GUI.Views.Pages.RegistrationManagement.EditContractView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="450" Height="Auto" Background="Transparent" FontFamily="Segoe UI">

    <UserControl.Resources>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#1D4ED8"/>
    </UserControl.Resources>

    <Border Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.2" Color="Gray"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Cập nhật Hợp đồng" FontSize="20" FontWeight="Bold" Foreground="#111827"/>
                <Button Command="{Binding CancelEditCommand}" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" 
                        FontSize="14" Width="30" Height="30" Background="Transparent" BorderThickness="0" 
                        HorizontalAlignment="Right" Cursor="Hand" Foreground="#6B7280"/>
            </Grid>

            <!-- Form -->
            <StackPanel Grid.Row="1">
                <!-- Thông tin Readonly -->
                <TextBlock Text="Học viên" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                <TextBox Text="{Binding EditingContract.StudentName, Mode=OneWay}" IsReadOnly="True" 
                         Padding="10,8" Background="#F3F4F6" BorderBrush="#E5E7EB" Margin="0,0,0,16"/>

                <!-- Chọn Lớp -->
                <TextBlock Text="Lớp đăng ký" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Classes}" SelectedValue="{Binding EditSelectedClassId}" SelectedValuePath="ClassID"
                          DisplayMemberPath="ClassName" Padding="10,8" Margin="0,0,0,16"/>

                <!-- Ngày đăng ký -->
                <TextBlock Text="Ngày đăng ký" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                <DatePicker SelectedDate="{Binding EditEnrollDate}" Padding="4" Margin="0,0,0,16"/>

                <!-- Trạng thái -->
                <TextBlock Text="Trạng thái" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding EditSelectedStatus}" Padding="10,8" Margin="0,0,0,16"/>
            </StackPanel>

            <!-- Footer Buttons -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Content="Hủy bỏ" Command="{Binding CancelEditCommand}" 
                        Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Foreground="#374151" 
                        Height="40" Margin="0,0,6,0" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="Lưu thay đổi" Command="{Binding SaveEditCommand}" Grid.Column="1"
                        Background="{StaticResource PrimaryBlue}" Foreground="White" BorderThickness="0" 
                        Height="40" Margin="6,0,0,0" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>