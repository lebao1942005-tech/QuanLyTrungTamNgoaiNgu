<UserControl x:Class="GUI.Views.Pages.RegistrationManagement.NewRegistrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1200"
             Background="#F3F4F6">

    <UserControl.Resources>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E5E7EB"/>

        <!-- Style cho ListBoxItem (Giữ nguyên như cũ) -->
        <Style x:Key="CardListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Border" Background="White" BorderBrush="{StaticResource BorderColor}" 
                                BorderThickness="1" CornerRadius="8" Padding="12" SnapsToDevicePixels="true">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryBlue}"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F9FAFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- CHIA BỐ CỤC CHÍNH THÀNH 2 PHẦN: NỘI DUNG VÀ FOOTER -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- Phần chọn danh sách -->
            <RowDefinition Height="Auto"/>
            <!-- Thanh xác nhận ở dưới -->
        </Grid.RowDefinitions>

        <!-- PHẦN 1: NỘI DUNG CHỌN (2 CỘT) -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: CHỌN HỌC VIÊN -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="#F9FAFB" CornerRadius="12,12,0,0" Padding="16" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#DBEAFE" Width="28" Height="28" CornerRadius="14" Margin="0,0,12,0">
                                <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#1D4ED8" FontSize="14"/>
                            </Border>
                            <TextBlock Text="Chọn Học Viên" FontWeight="Bold" Foreground="#111827" FontSize="16" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Search -->
                    <Border Grid.Row="1" Padding="16" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBox Text="{Binding StudentSearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     Padding="10,10,30,10" BorderThickness="1" BorderBrush="{StaticResource BorderColor}" Background="White" 
                                     FontSize="14" Tag="Tìm tên, mã HV, SĐT...">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#9CA3AF"/>
                        </Grid>
                    </Border>

                    <!-- ListBox -->
                    <ListBox Grid.Row="2" ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}" 
                             BorderThickness="0" Padding="16" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource CardListBoxItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="#111827" Margin="0,0,0,4"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE717;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,1,6,0"/>
                                            <TextBlock Text="{Binding Phone}" FontSize="13" Foreground="#4B5563"/>
                                            <TextBlock Text="|" FontSize="13" Foreground="#D1D5DB" Margin="8,0"/>
                                            <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,1,6,0"/>
                                            <TextBlock Text="{Binding Email}" FontSize="13" Foreground="#4B5563"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#F3F4F6" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="ID: " FontSize="11" Foreground="#6B7280"/>
                                            <TextBlock Text="{Binding StudentID}" FontSize="12" FontWeight="Bold" Foreground="#374151"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- CỘT PHẢI: CHỌN LỚP HỌC -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="#F9FAFB" CornerRadius="12,12,0,0" Padding="16" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#DBEAFE" Width="28" Height="28" CornerRadius="14" Margin="0,0,12,0">
                                <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#1D4ED8" FontSize="14"/>
                            </Border>
                            <TextBlock Text="Chọn Lớp Học" FontWeight="Bold" Foreground="#111827" FontSize="16" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Search -->
                    <Border Grid.Row="1" Padding="16" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBox Text="{Binding ClassSearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     Padding="10,10,30,10" BorderThickness="1" BorderBrush="{StaticResource BorderColor}" Background="White" 
                                     FontSize="14" Tag="Tìm lớp học...">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#9CA3AF"/>
                        </Grid>
                    </Border>

                    <!-- ListBox -->
                    <ListBox Grid.Row="2" ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}" 
                             BorderThickness="0" Padding="16" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource CardListBoxItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding ClassName}" FontWeight="Bold" FontSize="15" Foreground="#111827" Margin="0,0,10,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" 
           Text="{Binding TuitionFee, StringFormat='{}{0:N0} đ'}" 
           FontWeight="Bold" FontSize="14" Foreground="#1D4ED8" HorizontalAlignment="Right"/>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0">
                                        <Border Background="#F3F4F6" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,1,4,0"/>
                                                <TextBlock Text="{Binding Schedule}" FontSize="12" Foreground="#4B5563"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#DCFCE7" CornerRadius="4" Padding="6,2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#15803D" VerticalAlignment="Center" Margin="0,1,4,0"/>
                                                <TextBlock Text="{Binding MaxStudents, StringFormat='Max: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="#15803D"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- PHẦN 2: THANH XÁC NHẬN ĐĂNG KÝ (FOOTER BAR) -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="20,15" Margin="0,10,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.05" ShadowDepth="2" Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Học viên -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Gạch dọc -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Lớp -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Gạch dọc -->
                    <ColumnDefinition Width="*"/>
                    <!-- Học phí -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Button -->
                </Grid.ColumnDefinitions>

                <!-- 1. Thông tin Học viên -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" MinWidth="200">
                    <TextBlock Text="HỌC VIÊN" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding SelectedStudent.Name, TargetNullValue='-- Chưa chọn --'}" 
                               FontSize="16" FontWeight="Bold" Foreground="#111827" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Separator -->
                <Border Grid.Column="1" Width="1" Background="#E5E7EB" Margin="24,4"/>

                <!-- 2. Thông tin Lớp -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="200">
                    <TextBlock Text="LỚP ĐĂNG KÝ" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding SelectedClass.ClassName, TargetNullValue='-- Chưa chọn --'}" 
                               FontSize="16" FontWeight="Bold" Foreground="#1D4ED8" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Separator -->
                <Border Grid.Column="3" Width="1" Background="#E5E7EB" Margin="24,4"/>

                <!-- 3. Học phí tạm tính -->
                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <TextBlock Text="HỌC PHÍ TẠM TÍNH" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,4"/>
                    <!-- Giả lập hiển thị giá tiền, bạn có thể Bind nếu có -->
                    <TextBlock Text="{Binding SelectedClass.TuitionFee, StringFormat='{}{0:N0} đ', TargetNullValue='0 đ'}" 
           FontSize="16" FontWeight="Bold" Foreground="#DC2626">
                        <TextBlock.Style>
                            <!-- Giữ nguyên Style Trigger ẩn hiện cũ của bạn -->
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedClass}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- 4. Nút Xác nhận -->
                <Button Grid.Column="5" Command="{Binding RegisterCommand}" Content="Xác nhận Đăng Ký" 
                        Height="46" Padding="24,0" Background="{StaticResource PrimaryBlue}" Foreground="White" 
                        FontWeight="Bold" FontSize="15" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>

                    <!-- Thêm icon check vào nút -->
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,2,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>