<UserControl x:Class="GUI.Views.Pages.RegistrationManagement.RegistrationManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             
             xmlns:vm="clr-namespace:GUI.ViewModels"
             xmlns:local="clr-namespace:GUI.Views.Pages.RegistrationManagement"

             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1200"
             Background="#F3F4F6" FontFamily="Segoe UI">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:NewRegistrationViewModel}">
            <local:NewRegistrationView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ContractListViewModel}">
            <local:ContractListView/>
        </DataTemplate>

        <SolidColorBrush x:Key="PrimaryBlue" Color="#1D4ED8"/>

        <Style x:Key="HeaderTabRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,32,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <Border x:Name="BottomBar" Height="3" Background="{StaticResource PrimaryBlue}" VerticalAlignment="Bottom" Visibility="Collapsed" CornerRadius="1.5"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBlue}"/>
                                <Setter TargetName="BottomBar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#374151"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Quản lý Đăng Ký &amp; Hợp Đồng" FontSize="24" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal">

                    <RadioButton Content="Đăng ký mới" IsChecked="True" 
                                 Style="{StaticResource HeaderTabRadioButtonStyle}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Checked">
                                <i:InvokeCommandAction Command="{Binding SwitchTabCommand}" CommandParameter="NewRegistration"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </RadioButton>

                    <RadioButton Content="Danh sách hợp đồng" 
                                 Style="{StaticResource HeaderTabRadioButtonStyle}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Checked">
                                <i:InvokeCommandAction Command="{Binding SwitchTabCommand}" CommandParameter="ContractList"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </RadioButton>
                </StackPanel>

                <Border Background="#E5E7EB" Height="1" VerticalAlignment="Bottom" Margin="0,-1,0,0"/>
            </StackPanel>
        </Grid>

        <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>

    </Grid>
</UserControl>