<UserControl x:Class="GUI.Views.Pages.RegistrationManagement.DeleteContractView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="400" Height="Auto" Background="Transparent" FontFamily="Segoe UI">

    <Border Background="White" CornerRadius="12" BorderThickness="0" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>
        <StackPanel>
            <Border Background="#FEE2E2" Width="50" Height="50" CornerRadius="25" HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#DC2626" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="Xóa hợp đồng?" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8" Foreground="#111827"/>

            <TextBlock Text="Hành động này không thể hoàn tác. Bạn có chắc chắn muốn xóa dữ liệu đăng ký này không?" 
                       TextWrapping="Wrap" TextAlignment="Center" Foreground="#6B7280" Margin="0,0,0,24"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="Hủy bỏ" Command="{Binding CancelDeleteCommand}" 
                        Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Foreground="#374151" 
                        Height="40" Margin="0,0,6,0" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="Xóa bỏ" Command="{Binding ConfirmDeleteCommand}" Grid.Column="1"
                        Background="#DC2626" Foreground="White" BorderThickness="0" 
                        Height="40" Margin="6,0,0,0" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>