<UserControl x:Class="GUI.Views.Pages.RegistrationManagement.ContractListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             
             xmlns:local="clr-namespace:GUI.Views.Pages.RegistrationManagement"
             
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1200"
             Background="Transparent" FontFamily="Segoe UI">

    <UserControl.Resources>
        <!-- Converter -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- (Giữ nguyên các Brush) -->
        <SolidColorBrush x:Key="PrimaryBlue" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="GreenText" Color="#16A34A"/>
        <SolidColorBrush x:Key="GreenBg" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="RedText" Color="#DC2626"/>
        <SolidColorBrush x:Key="RedBg" Color="#FEE2E2"/>
        <SolidColorBrush x:Key="GrayText" Color="#6B7280"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="HoverColor" Color="#F9FAFB"/>

        <!-- (Giữ nguyên Style IconButtonStyle) -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- CONTENT CHÍNH -->
        <Border Background="White" CornerRadius="12" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER & FILTER -->
                <Grid Grid.Row="0" Margin="24,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Danh sách hợp đồng" FontSize="18" FontWeight="Bold" Foreground="#111827"/>
                        <Border Background="#EFF6FF" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Enrollments.Count, StringFormat='Total: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBlue}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Margin="0,0,12,0" Background="White">
                            <ComboBox Width="160" SelectedIndex="0" Padding="10,6" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="Tất cả trạng thái"/>
                                <ComboBoxItem Content="Đang học (Active)"/>
                                <ComboBoxItem Content="Đã hủy (Cancelled)"/>
                            </ComboBox>
                        </Border>

                        <Border Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Width="250" Height="38">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="12,0,8,0" Foreground="#9CA3AF" FontSize="14"/>
                                <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                         VerticalAlignment="Center" BorderThickness="0" Background="Transparent" 
                                         Padding="0,0,10,0" Tag="Tìm mã HĐ, tên HV..."/>
                            </Grid>
                        </Border>

                        <!-- ĐÃ XÓA NÚT XUẤT EXCEL TẠI ĐÂY -->
                    </StackPanel>
                </Grid>

                <!-- DATA GRID -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding Enrollments}" AutoGenerateColumns="False" CanUserAddRows="False" 
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F3F4F6"
                          BorderThickness="0" Background="White" RowHeight="56" Padding="0,0,0,10">

                    <!-- (Giữ nguyên Style ColumnHeader, RowStyle, CellStyle như cũ) -->
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#6B7280"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="24,0,0,12"/>
                            <Setter Property="Height" Value="40"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="VerticalContentAlignment" Value="Bottom"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource HoverColor}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="24,0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}" BorderThickness="0" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="MÃ HĐ" Binding="{Binding EnrollmentId}" Width="100" Foreground="#111827" FontWeight="SemiBold" FontFamily="Consolas"/>

                        <DataGridTemplateColumn Header="HỌC VIÊN" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding StudentName}" FontWeight="SemiBold" Foreground="#111827" FontSize="14"/>
                                        <TextBlock Text="{Binding StudentId}" FontSize="12" Foreground="{StaticResource GrayText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="LỚP HỌC" Binding="{Binding ClassName}" Width="180" Foreground="#111827" FontWeight="SemiBold" FontSize="14"/>

                        <DataGridTextColumn Header="NGÀY ĐK" Binding="{Binding EnrollDate, StringFormat='dd/MM/yyyy'}" Width="150" Foreground="{StaticResource GrayText}"/>

                        <DataGridTemplateColumn Header="TRẠNG THÁI" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="Badge" CornerRadius="12" Padding="10,4" HorizontalAlignment="Left">
                                        <TextBlock x:Name="StatusText" Text="{Binding Status}" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Active">
                                            <Setter TargetName="Badge" Property="Background" Value="{StaticResource GreenBg}"/>
                                            <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource GreenText}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                            <Setter TargetName="Badge" Property="Background" Value="{StaticResource RedBg}"/>
                                            <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource RedText}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="HÀNH ĐỘNG" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Nút Sửa -->
                                        <Button Style="{StaticResource IconButtonStyle}" ToolTip="Sửa thông tin" Margin="0,0,4,0"
                                                Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#D97706"/>
                                        </Button>

                                        <!-- Nút Xóa -->
                                        <Button Style="{StaticResource IconButtonStyle}" ToolTip="Xóa hợp đồng"
                                                Command="{Binding DataContext.OpenDeleteDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#EF4444"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- FOOTER -->
                <Border Grid.Row="2" Padding="24,16" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0">
                    <Grid>
                        <!-- Hiển thị thông tin trang bên trái -->
                        <TextBlock Text="{Binding PagingInfo}" VerticalAlignment="Center" Foreground="#6B7280" FontWeight="SemiBold"/>

                        <!-- Nút điều hướng bên phải -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                            <!-- Nút Trước -->
                            <Button Content="Trước" 
                    Command="{Binding PreviousPageCommand}"
                    Padding="12,6" 
                    Background="White" 
                    BorderBrush="{StaticResource BorderColor}" 
                    BorderThickness="1" 
                    Margin="0,0,8,0"
                    Cursor="Hand"/>

                            <!-- Nút Sau -->
                            <Button Content="Sau" 
                    Command="{Binding NextPageCommand}"
                    Padding="12,6" 
                    Background="White" 
                    BorderBrush="{StaticResource BorderColor}" 
                    BorderThickness="1"
                    Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- POPUP SỬA -->
        <Grid Visibility="{Binding IsEditPopupOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="100">
            <Border Background="Black" Opacity="0.4"/>
            <local:EditContractView HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- POPUP XÓA -->
        <Grid Visibility="{Binding IsDeletePopupOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="100">
            <Border Background="Black" Opacity="0.4"/>
            <local:DeleteContractView HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

    </Grid>
</UserControl>