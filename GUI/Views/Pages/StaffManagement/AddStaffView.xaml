<UserControl x:Class="GUI.Views.Pages.StaffManagement.AddStaffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="500" Height="Auto"
             Background="Transparent" FontFamily="Roboto">

    <UserControl.Resources>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#1D4ED8"/>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <!-- Container chính -->
    <Border Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.2" Color="Gray"/>
        </Border.Effect>

        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="*"/>
                <!-- Form -->
                <RowDefinition Height="Auto"/>
                <!-- Footer Buttons -->
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Thêm nhân viên mới" FontSize="20" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center"/>
                <Button Command="{Binding CancelCommand}" 
                        Content="&#xE711;" FontFamily="Segoe MDL2 Assets" 
                        FontSize="12" Width="30" Height="30" 
                        Background="Transparent" BorderThickness="0" 
                        HorizontalAlignment="Right" Cursor="Hand"/>
            </Grid>

            <!-- 2. Form Fields -->
            <StackPanel Grid.Row="1" VerticalAlignment="Top">

                <!-- Họ tên -->
                <TextBlock Text="Họ và tên" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#374151"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>

                <!-- SĐT & Email (Chung hàng) -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Số điện thoại" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#374151"/>
                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Email" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#374151"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <!-- Chức vụ & Phòng ban (Chung hàng) -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cột Chức vụ -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Chức vụ" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#374151"/>
                        <ComboBox Text="{Binding Position, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEditable="False">
                            <!-- Chỉ hiện 2 quyền như yêu cầu -->
                            <ComboBoxItem Content="Giáo viên"/>
                            <ComboBoxItem Content="Quản trị viên"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Cột Phòng ban -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Phòng ban" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#374151"/>
                        <ComboBox Text="{Binding Department, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEditable="True">
                            <ComboBoxItem Content="Phòng Đào Tạo"/>
                            <ComboBoxItem Content="Phòng Kế Toán"/>
                            <ComboBoxItem Content="Phòng Hành Chính"/>
                            <ComboBoxItem Content="Khoa Ngoại Ngữ"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Ngày vào làm -->
                <TextBlock Text="Ngày vào làm" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#374151"/>
                <DatePicker SelectedDate="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}" Height="38" VerticalContentAlignment="Center" BorderBrush="#E5E7EB" BorderThickness="1" Background="White"/>

                <!-- SECTION TẠO TÀI KHOẢN -->
                <Border Background="#F3F4F6" CornerRadius="8" Padding="15" Margin="0,20,0,0" BorderBrush="#E5E7EB" BorderThickness="1">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding IsCreateAccount}" 
                                  Content="Cấp tài khoản đăng nhập hệ thống" 
                                  FontWeight="SemiBold" Foreground="#111827" 
                                  VerticalContentAlignment="Center" Cursor="Hand"/>

                        <TextBlock Text="Tài khoản mặc định sẽ là Mã NV, mật khẩu là '123'. Quyền truy cập (Admin/Teacher) sẽ dựa trên Chức vụ bạn chọn ở trên." 
                                   FontSize="12" Foreground="#6B7280" TextWrapping="Wrap" Margin="24,5,0,0" LineHeight="18"/>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- 3. Footer Buttons -->
            <Grid Grid.Row="2" Margin="0,25,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Content="Hủy bỏ" Command="{Binding CancelCommand}" 
                        Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Foreground="#374151" 
                        Height="40" Margin="0,0,5,0" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="Lưu nhân viên" Command="{Binding SaveCommand}" Grid.Column="1" 
                        Background="{StaticResource PrimaryBlue}" Foreground="White" BorderThickness="0" 
                        Height="40" Margin="5,0,0,0" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>