<UserControl x:Class="GUI.Views.Pages.ClassManagement.ClassManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             
             xmlns:viewModel="clr-namespace:GUI.ViewModels"
             xmlns:local="clr-namespace:GUI.Views.Pages.ClassManagement"
             
             d:DesignHeight="750" d:DesignWidth="1200"
             Background="#F3F4F6" FontFamily="Segoe UI">

    <UserControl.Resources>

        <DataTemplate DataType="{x:Type viewModel:ClassInfoViewModel}">
            <local:ClassInfoView/>
        </DataTemplate>


        <DataTemplate DataType="{x:Type viewModel:ClassStudentListViewModel}">
            <local:ClassStudentListView/>
        </DataTemplate>


        <SolidColorBrush x:Key="PrimaryBlue" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="GreenText" Color="#15803D"/>
        <SolidColorBrush x:Key="GreenBg" Color="#DCFCE7"/>

        <!-- Style Sidebar Item -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Border" Padding="16,12" Background="Transparent" 
                                BorderThickness="4,0,0,1" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryBlue}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F9FAFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Tab Header (RadioButton) -->
        <Style x:Key="HeaderTabRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,24,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <!-- Thanh gạch chân -->
                            <Border x:Name="BottomBar" Height="3" Background="{StaticResource PrimaryBlue}" VerticalAlignment="Bottom" Visibility="Collapsed" CornerRadius="1.5"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBlue}"/>
                                <Setter TargetName="BottomBar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#374151"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <!-- Sidebar -->
            <ColumnDefinition Width="*"/>
            <!-- Content -->
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header Sidebar -->
                <StackPanel Grid.Row="0" Margin="16">
                    <TextBlock Text="Danh sách lớp" FontSize="18" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,12"/>

                    <!-- Action Buttons (Tạo, Sửa, Xóa) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Nút Tạo Lớp -->
                        <Button Content="Tạo lớp" Background="{StaticResource PrimaryBlue}" Foreground="White" Height="36" Margin="0,0,8,0" Style="{StaticResource {x:Type Button}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Tạo lớp" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Nút Sửa Lớp (Mới thêm) -->
                        <Button Grid.Column="1" Width="40" Height="36" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Cursor="Hand" ToolTip="Sửa lớp đang chọn" Margin="0,0,8,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" Foreground="#6B7280" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Nút Xóa Lớp -->
                        <Button Grid.Column="2" Width="40" Height="36" Background="#FEF2F2" BorderBrush="#FEE2E2" BorderThickness="1" Cursor="Hand" ToolTip="Xóa lớp đang chọn">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- ListBox -->
                <ListBox Grid.Row="2" ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}" 
                         Background="White" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding ClassName}" FontWeight="Bold" Foreground="#111827"/>
                                <TextBlock Text="{Binding ClassId}" FontSize="12" Foreground="Gray"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- RIGHT CONTENT -->
        <Grid Grid.Column="1" Background="#F9FAFB">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header + Tabs -->
                <RowDefinition Height="*"/>
                <!-- Dynamic Content -->
            </Grid.RowDefinitions>

            <!-- 1. Header & Tabs Container -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="32,24,32,0">
                <StackPanel>
                    <!-- Class Info Tóm tắt -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="{Binding SelectedClass.ClassName}" FontSize="24" FontWeight="Bold" Foreground="#111827"/>
                        <Border Background="{StaticResource GreenBg}" CornerRadius="12" Padding="10,2" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Đang học" FontSize="12" FontWeight="Bold" Foreground="{StaticResource GreenText}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <TextBlock Text="GV: " Foreground="#6B7280" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SelectedClass.TeacherName}" Foreground="#374151" Margin="0,0,16,0"/>
                        <TextBlock Text="Phòng: " Foreground="#6B7280" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SelectedClass.RoomName}" Foreground="#374151" Margin="0,0,16,0"/>
                    </StackPanel>

                    <!-- Custom Tabs (RadioButtons) -->
                    <StackPanel Orientation="Horizontal">

                        <RadioButton Content="Thông tin" IsChecked="True" Style="{StaticResource HeaderTabRadioButtonStyle}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Checked">
                                    <!-- SỬA: Truyền chuỗi "Info" trực tiếp -->
                                    <i:InvokeCommandAction Command="{Binding SwitchTabCommand}" CommandParameter="Info"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </RadioButton>

                        <RadioButton Content="Danh sách học viên" Style="{StaticResource HeaderTabRadioButtonStyle}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Checked">
                                    <!-- SỬA: Truyền chuỗi "Students" trực tiếp -->
                                    <i:InvokeCommandAction Command="{Binding SwitchTabCommand}" CommandParameter="Students"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </RadioButton>

                        <RadioButton Content="Chấm điểm" Style="{StaticResource HeaderTabRadioButtonStyle}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Checked">
                                    <!-- SỬA: Truyền chuỗi "Grading" trực tiếp -->
                                    <i:InvokeCommandAction Command="{Binding SwitchTabCommand}" CommandParameter="Grading"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </RadioButton>

                        <RadioButton Content="Điểm danh" Style="{StaticResource HeaderTabRadioButtonStyle}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Checked">
                                    <!-- SỬA: Truyền chuỗi "Attendance" trực tiếp -->
                                    <i:InvokeCommandAction Command="{Binding SwitchTabCommand}" CommandParameter="Attendance"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </RadioButton>

                    </StackPanel>


                </StackPanel>
            </Border>

            <!-- 2. Dynamic Content Area -->
            <ContentControl x:Name="TabContent" 
                Grid.Row="1" 
                Margin="10,10,10,10"
                Content="{Binding CurrentView}" />

        </Grid>
    </Grid>
</UserControl>