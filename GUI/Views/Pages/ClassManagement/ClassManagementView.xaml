<UserControl x:Class="GUI.Views.Pages.ClassManagement.ClassManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             
             xmlns:viewModel="clr-namespace:GUI.ViewModels"
             xmlns:local="clr-namespace:GUI.Views.Pages.ClassManagement"
             
             d:DesignHeight="750" d:DesignWidth="1200"
             Background="#F3F4F6" FontFamily="Segoe UI">

    <UserControl.Resources>
        <!-- Converter Boolean -> Visibility cho Popup -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <DataTemplate DataType="{x:Type viewModel:ClassInfoViewModel}">
            <local:ClassInfoView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:ClassStudentListViewModel}">
            <local:ClassStudentListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:ClassGradingViewModel}">
            <local:ClassGradingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:ClassAttendanceViewModel}">
            <local:ClassAttendanceView/>
        </DataTemplate>

        <SolidColorBrush x:Key="PrimaryBlue" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="GreenText" Color="#15803D"/>
        <SolidColorBrush x:Key="GreenBg" Color="#DCFCE7"/>

        <!-- (Giữ nguyên các Style cũ) -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Border" Padding="16,12" Background="Transparent" 
                                BorderThickness="4,0,0,1" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryBlue}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F9FAFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderTabRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,24,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <Border x:Name="BottomBar" Height="3" Background="{StaticResource PrimaryBlue}" VerticalAlignment="Bottom" Visibility="Collapsed" CornerRadius="1.5"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBlue}"/>
                                <Setter TargetName="BottomBar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#374151"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <UserControl.DataContext>
        <viewModel:ClassManagementViewModel/>
    </UserControl.DataContext>

    <!-- Container Chính -->
    <Grid>
        <!-- LỚP 1: GIAO DIỆN CHÍNH -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="16">
                        <TextBlock Text="Danh sách lớp" FontSize="18" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,12"/>

                        <!-- Action Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Nút Tạo Lớp -->
                            <Button Command="{Binding OpenAddDialogCommand}" Content="Tạo lớp" Background="{StaticResource PrimaryBlue}" Foreground="White" Height="36" Margin="0,0,8,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Tạo lớp" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Nút Sửa Lớp -->
                            <Button Command="{Binding OpenEditDialogCommand}" Grid.Column="1" Width="40" Height="36" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,0,8,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" Foreground="#6B7280" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- NÚT XÓA LỚP (ĐÃ THÊM BINDING) -->
                            <Button Command="{Binding OpenDeleteDialogCommand}" 
                                    CommandParameter="{Binding SelectedClass}"
                                    Grid.Column="2" Width="40" Height="36" Background="#FEF2F2" BorderBrush="#FEE2E2" BorderThickness="1" Cursor="Hand" ToolTip="Xóa lớp đang chọn">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- ListBox Class List (ĐÃ CẬP NHẬT GIAO DIỆN) -->
                    <ListBox Grid.Row="2" ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}" Background="White" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <!-- Dòng 1: Tên Lớp -->
                                    <TextBlock Text="{Binding ClassName}" FontWeight="Bold" Foreground="#111827" FontSize="14" Margin="0,0,0,2"/>

                                    <!-- Dòng 2: Tên Khóa Học -->
                                    <TextBlock Text="{Binding CourseName}" FontSize="12" Foreground="#6B7280" Margin="0,0,0,6"/>

                                    <!-- Dòng 3: Giáo viên & Sĩ số (Chia cột) -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Giáo viên -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#9CA3AF" Margin="0,1,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding TeacherName}" FontSize="12" Foreground="#4B5563" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Sĩ số (Max) -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#9CA3AF" Margin="0,1,6,0" VerticalAlignment="Center"/>

                                            <!-- SỬA LỖI: StringFormat phải nằm trong Binding -->
                                            <TextBlock Text="{Binding MaxStudents, StringFormat='Max: {0}'}" FontSize="12" Foreground="#4B5563"/>

                                            <!-- Nếu bạn muốn hiển thị kiểu số/số (ví dụ 10/20), hãy dùng đoạn code này: -->
                                            <!--
                                            <TextBlock FontSize="12" Foreground="#4B5563">
                                                <Run Text="{Binding StudentCount, FallbackValue=0}" />
                                                <Run Text="/" />
                                                <Run Text="{Binding MaxStudents}" />
                                            </TextBlock>
                                            -->
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- RIGHT CONTENT (Giữ nguyên) -->
            <Grid Grid.Column="1" Background="#F9FAFB">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="32,24,32,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="{Binding SelectedClass.ClassName}" FontSize="24" FontWeight="Bold" Foreground="#111827"/>
                            <Border Background="{StaticResource GreenBg}" CornerRadius="12" Padding="10,2" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Đang học" FontSize="12" FontWeight="Bold" Foreground="{StaticResource GreenText}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <TextBlock Text="GV: " Foreground="#6B7280" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedClass.TeacherName}" Foreground="#374151" Margin="0,0,16,0"/>
                            <!--   <TextBlock Text="Phòng: " Foreground="#6B7280" FontWeight="SemiBold"/>  -->
                            <!--                       <TextBlock Text="{Binding SelectedClass.RoomName}" Foreground="#374151" Margin="0,0,16,0"/>  -->
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Thông tin" IsChecked="True" Style="{StaticResource HeaderTabRadioButtonStyle}">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Checked">
                                        <i:InvokeCommandAction Command="{Binding SwitchTabCommand}" CommandParameter="Info"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </RadioButton>
                            <RadioButton Content="Danh sách học viên" Style="{StaticResource HeaderTabRadioButtonStyle}">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Checked">
                                        <i:InvokeCommandAction Command="{Binding SwitchTabCommand}" CommandParameter="Students"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </RadioButton>
                            <RadioButton Content="Chấm điểm" Style="{StaticResource HeaderTabRadioButtonStyle}">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Checked">
                                        <i:InvokeCommandAction Command="{Binding SwitchTabCommand}" CommandParameter="Grading"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </RadioButton>
                            <RadioButton Content="Điểm danh" Style="{StaticResource HeaderTabRadioButtonStyle}">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Checked">
                                        <i:InvokeCommandAction Command="{Binding SwitchTabCommand}" CommandParameter="Attendance"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </RadioButton>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ContentControl x:Name="TabContent" Grid.Row="1" Margin="10" Content="{Binding CurrentView}" />
            </Grid>
        </Grid>

        <!-- LỚP 2: POPUP OVERLAY (Thêm Lớp) -->
        <Grid Visibility="{Binding IsAddPopupOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="99">
            <Border Background="Black" Opacity="0.4"/>
            <local:AddClassView HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- LỚP 3: POPUP OVERLAY (Xóa Lớp) - MỚI THÊM -->
        <!-- Hiển thị khi biến IsDeletePopupOpen = True -->
        <Grid Visibility="{Binding IsDeletePopupOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="99">
            <Border Background="Black" Opacity="0.4"/>
            <local:DeleteClassView HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>


        <Grid Visibility="{Binding IsEditPopupOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="100">
            <Border Background="Black" Opacity="0.4"/>
            <local:EditClassView HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

    </Grid>
</UserControl>