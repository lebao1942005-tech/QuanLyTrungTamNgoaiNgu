<UserControl x:Class="GUI.Views.Pages.ClassManagement.ClassManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GUI.Views.Pages.ClassManagement"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200"
             Background="#F3F4F6" FontFamily="Segoe UI">

    <UserControl.Resources>
        <!-- ================= COLORS ================= -->
        <SolidColorBrush x:Key="PrimaryBlue" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="OrangeBg" Color="#F97316"/>

        <!-- Status Colors -->
        <SolidColorBrush x:Key="GreenText" Color="#059669"/>
        <SolidColorBrush x:Key="GreenBg" Color="#D1FAE5"/>
        <SolidColorBrush x:Key="YellowText" Color="#D97706"/>
        <SolidColorBrush x:Key="YellowBg" Color="#FEF3C7"/>
        <SolidColorBrush x:Key="RedText" Color="#C2410C"/>
        <!-- Màu cam đậm cho Kết thúc -->
        <SolidColorBrush x:Key="RedBg" Color="#FFEDD5"/>

        <!-- ================= STYLES ================= -->

        <!-- Style cho nút Toolbar -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style cho nút hành động trong bảng -->
        <Style x:Key="GridActionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" Foreground="#6B7280"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Toolbar -->
            <RowDefinition Height="*"/>
            <!-- Table -->
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <TextBlock Text="Danh sách lớp học" FontSize="24" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,20"/>

        <!-- 2. Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search Box -->
            <Border Grid.Column="0" Width="300" Height="40" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Left">
                <Grid>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#9CA3AF"/>
                    <TextBox Text="Tìm lớp học..." VerticalAlignment="Center" Margin="35,0,10,0" BorderThickness="0" Background="Transparent" Foreground="#6B7280"/>
                </Grid>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" Grid.Column="2">
                <Button x:Name="BtnAddClass" Content="Thêm lớp" Tag="&#xE710;" Background="{StaticResource PrimaryBlue}" Foreground="White" Style="{StaticResource ToolbarButtonStyle}"/>
                
            </StackPanel>
        </Grid>

        <!-- 3. Data Grid -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="0" BorderBrush="#E5E7EB" BorderThickness="1" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Classes}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F3F4F6" BorderThickness="0" Background="White" RowHeight="70">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource PrimaryBlue}"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="15,12"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <!-- Cột 1: Lớp học (Avatar + Tên + Mã) -->
                    <DataGridTemplateColumn Header="LỚP HỌC" Width="2.5*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Avatar Lớp (Chữ cái đầu) -->
                                    <Border Width="40" Height="40" CornerRadius="8" Background="#E0E7FF" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding ClassInitial}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ClassName}" FontWeight="SemiBold" FontSize="14" Foreground="#111827"/>
                                        <TextBlock Text="{Binding ClassId}" FontSize="12" Foreground="#6B7280" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Cột 2: Giảng viên -->
                    <DataGridTextColumn Header="GIẢNG VIÊN" Binding="{Binding TeacherName}" Width="1.5*" FontWeight="Medium" Foreground="#374151"/>

                    <!-- Cột 3: Lịch học -->
                    <DataGridTextColumn Header="LỊCH HỌC" Binding="{Binding Schedule}" Width="1.5*" Foreground="#6B7280"/>

                    <!-- Cột 4: Phòng -->
                    <DataGridTextColumn Header="PHÒNG" Binding="{Binding RoomName}" Width="100" Foreground="#374151"/>

                    <!-- Cột 5: Sĩ số -->
                    <DataGridTemplateColumn Header="SĨ SỐ" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#F3F4F6" CornerRadius="6" Padding="8,2" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding CapacityDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="#374151"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Cột 6: Trạng thái (Badge màu) -->
                    <DataGridTemplateColumn Header="TRẠNG THÁI" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" x:Name="StatusBorder">
                                    <TextBlock x:Name="StatusText" Text="{Binding Status}" FontSize="12" FontWeight="SemiBold"/>
                                </Border>

                                <!-- Triggers đổi màu theo trạng thái -->
                                <DataTemplate.Triggers>
                                    <!-- Đang học -> Xanh lá -->
                                    <DataTrigger Binding="{Binding Status}" Value="Đang học">
                                        <Setter TargetName="StatusBorder" Property="Background" Value="{StaticResource GreenBg}"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource GreenText}"/>
                                    </DataTrigger>
                                    <!-- Sắp mở -> Vàng -->
                                    <DataTrigger Binding="{Binding Status}" Value="Sắp mở">
                                        <Setter TargetName="StatusBorder" Property="Background" Value="{StaticResource YellowBg}"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource YellowText}"/>
                                    </DataTrigger>
                                    <!-- Kết thúc -> Cam/Đỏ -->
                                    <DataTrigger Binding="{Binding Status}" Value="Kết thúc">
                                        <Setter TargetName="StatusBorder" Property="Background" Value="{StaticResource RedBg}"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource RedText}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Cột 7: Chức năng -->
                    <DataGridTemplateColumn Header="CHỨC NĂNG" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="&#xE7B3;" ToolTip="Xem chi tiết" Style="{StaticResource GridActionButton}" Foreground="#1D4ED8"/>
                                    <Button Content="&#xE70F;" ToolTip="Chỉnh sửa" Style="{StaticResource GridActionButton}" Foreground="#D97706"/>
                                    <Button Content="&#xE74D;" ToolTip="Xóa" Style="{StaticResource GridActionButton}" Foreground="#DC2626"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>