<UserControl x:Class="GUI.Views.Pages.ClassManagement.ClassAttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             Background="Transparent" FontFamily="Segoe UI">

    <UserControl.Resources>
        <!-- COLORS -->
        <SolidColorBrush x:Key="PrimaryBlue" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="GrayText" Color="#6B7280"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E5E7EB"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Status Colors -->
        <SolidColorBrush x:Key="GreenText" Color="#15803D"/>
        <SolidColorBrush x:Key="GreenBg" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="RedText" Color="#B91C1C"/>
        <SolidColorBrush x:Key="RedBg" Color="#FEE2E2"/>
        <SolidColorBrush x:Key="BlueText" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="BlueBg" Color="#DBEAFE"/>
        <SolidColorBrush x:Key="YellowText" Color="#B45309"/>
        <SolidColorBrush x:Key="YellowBg" Color="#FEF3C7"/>

        <!-- STYLE: Stat Badge (Thống kê trên toolbar) -->
        <Style x:Key="StatBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- STYLE: Attendance Chip RadioButton (Nút bấm chọn trạng thái) -->
        <Style x:Key="AttendanceChipStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bdr" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="12,6" MinWidth="70">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bdr" Property="BorderThickness" Value="0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#F9FAFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styles màu sắc cho nút -->
        <Style x:Key="ChipPresent" TargetType="RadioButton" BasedOn="{StaticResource AttendanceChipStyle}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource GreenBg}"/>
                    <Setter Property="Foreground" Value="{StaticResource GreenText}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChipAbsent" TargetType="RadioButton" BasedOn="{StaticResource AttendanceChipStyle}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource RedBg}"/>
                    <Setter Property="Foreground" Value="{StaticResource RedText}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChipExcused" TargetType="RadioButton" BasedOn="{StaticResource AttendanceChipStyle}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource BlueBg}"/>
                    <Setter Property="Foreground" Value="{StaticResource BlueText}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChipLate" TargetType="RadioButton" BasedOn="{StaticResource AttendanceChipStyle}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource YellowBg}"/>
                    <Setter Property="Foreground" Value="{StaticResource YellowText}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- STYLE MỚI: Note TextBox (Ô ghi chú có khung rõ ràng) -->
        <Style x:Key="NoteTextBoxStyle" TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryBlue}"/>
                            </Trigger>
                            <!-- Khi ở chế độ Xem (ReadOnly) thì ẩn khung đi -->
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="4,6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="White" CornerRadius="12" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. TOOLBAR -->
            <Border Grid.Row="0" Padding="20,16" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Background="#F9FAFB" CornerRadius="12,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Chọn buổi học (Cập nhật thêm ComboBox Lịch sử) -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                            <!-- DatePicker -->
                            <StackPanel>
                                <TextBlock Text="Ngày điểm danh" FontSize="10" Foreground="#6B7280" Margin="0,0,0,2" FontWeight="SemiBold"/>
                                <DatePicker SelectedDate="{Binding SelectedDate}" Width="130" Padding="4" BorderBrush="#D1D5DB" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <Border Width="1" Height="24" Background="#E5E7EB" Margin="16,0"/>

                            <!-- ComboBox Lịch sử (Mới thêm) -->
                            <StackPanel>
                                <TextBlock Text="Lịch sử điểm danh" FontSize="10" Foreground="#6B7280" Margin="0,0,0,2" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding AttendanceDates}" 
                                          SelectedItem="{Binding SelectedDate}"
                                          Width="150" Height="32" 
                                          Padding="6,4" BorderBrush="#D1D5DB"
                                          VerticalContentAlignment="Center"
                                          ItemStringFormat="dd/MM/yyyy"
                                          Background="White"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Stats -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource StatBadgeStyle}" Background="{StaticResource GreenBg}" BorderBrush="{StaticResource GreenBg}">
                                <TextBlock Text="{Binding CountPresent, StringFormat='Có mặt: {0}'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource GreenText}"/>
                            </Border>
                            <Border Style="{StaticResource StatBadgeStyle}" Background="{StaticResource RedBg}" BorderBrush="{StaticResource RedBg}">
                                <TextBlock Text="{Binding CountAbsent, StringFormat='Vắng: {0}'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource RedText}"/>
                            </Border>
                            <Border Style="{StaticResource StatBadgeStyle}" Background="{StaticResource BlueBg}" BorderBrush="{StaticResource BlueBg}">
                                <TextBlock Text="{Binding CountExcused, StringFormat='Phép: {0}'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BlueText}"/>
                            </Border>
                            <Border Style="{StaticResource StatBadgeStyle}" Background="{StaticResource YellowBg}" BorderBrush="{StaticResource YellowBg}">
                                <TextBlock Text="{Binding CountLate, StringFormat='Trễ: {0}'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource YellowText}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!-- Nút Chỉnh sửa -->
                        <Button Background="White" BorderBrush="{StaticResource PrimaryBlue}" BorderThickness="1" Padding="16,8" Cursor="Hand"
                                Command="{Binding StartEditCommand}"
                                Visibility="{Binding IsReadOnlyMode, Converter={StaticResource BoolToVis}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryBlue}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Điểm danh" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}"/>
                            </StackPanel>
                        </Button>

                        <!-- Nhóm Lưu/Hủy -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                            <Button Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Padding="16,8" Margin="0,0,10,0" Cursor="Hand"
                                    Command="{Binding CancelEditCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="Hủy bỏ" FontSize="13" FontWeight="SemiBold" Foreground="#374151"/>
                            </Button>

                            <Button Background="{StaticResource PrimaryBlue}" BorderThickness="0" Padding="16,8" Cursor="Hand"
                                    Command="{Binding SaveAttendanceCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Lưu lại" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. DATAGRID -->
            <DataGrid Grid.Row="1" 
                      ItemsSource="{Binding AttendanceList}" 
                      AutoGenerateColumns="False" CanUserAddRows="False" 
                      BorderThickness="0" Background="White" RowHeight="60"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F3F4F6"
                      Padding="0,0,0,10">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#9CA3AF"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="16,0,0,10"/>
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="VerticalContentAlignment" Value="Bottom"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="16,0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="STT" Binding="{Binding Index}" Width="60" Foreground="{StaticResource GrayText}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="MÃ HV" Binding="{Binding StudentCode}" Width="100" Foreground="{StaticResource PrimaryBlue}" FontWeight="Medium">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="HỌ TÊN" Binding="{Binding Name}" Width="200" FontWeight="SemiBold" Foreground="#111827">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- CỘT TRẠNG THÁI -->
                    <DataGridTemplateColumn Header="TRẠNG THÁI" Width="360">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <!-- 1. VIEW MODE (Chỉ hiện Badge kết quả) -->
                                    <Border x:Name="ViewBadge" CornerRadius="6" Padding="12,6" HorizontalAlignment="Left"
                                            Visibility="{Binding DataContext.IsReadOnlyMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                        <TextBlock x:Name="ViewText" FontSize="12" FontWeight="Bold"/>
                                    </Border>

                                    <!-- 2. EDIT MODE (Hiện 4 nút chọn) -->
                                    <StackPanel Orientation="Horizontal"
            Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">

                                        <RadioButton Content="Có mặt"
                 IsChecked="{Binding IsPresent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource ChipPresent}" />

                                        <RadioButton Content="Vắng"
                 IsChecked="{Binding IsAbsent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource ChipAbsent}" />

                                        <RadioButton Content="Phép"
                 IsChecked="{Binding IsExcused, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource ChipExcused}" />

                                        <RadioButton Content="Trễ"
                 IsChecked="{Binding IsLate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource ChipLate}" />

                                    </StackPanel>
                                </Grid>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Present">
                                        <Setter TargetName="ViewBadge" Property="Background" Value="{StaticResource GreenBg}"/>
                                        <Setter TargetName="ViewText" Property="Text" Value="Có mặt"/>
                                        <Setter TargetName="ViewText" Property="Foreground" Value="{StaticResource GreenText}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Absent">
                                        <Setter TargetName="ViewBadge" Property="Background" Value="{StaticResource RedBg}"/>
                                        <Setter TargetName="ViewText" Property="Text" Value="Vắng"/>
                                        <Setter TargetName="ViewText" Property="Foreground" Value="{StaticResource RedText}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Excused">
                                        <Setter TargetName="ViewBadge" Property="Background" Value="{StaticResource BlueBg}"/>
                                        <Setter TargetName="ViewText" Property="Text" Value="Phép"/>
                                        <Setter TargetName="ViewText" Property="Foreground" Value="{StaticResource BlueText}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Late">
                                        <Setter TargetName="ViewBadge" Property="Background" Value="{StaticResource YellowBg}"/>
                                        <Setter TargetName="ViewText" Property="Text" Value="Trễ"/>
                                        <Setter TargetName="ViewText" Property="Foreground" Value="{StaticResource YellowText}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- GHI CHÚ (ÁP DỤNG STYLE MỚI) -->
                    <DataGridTemplateColumn Header="GHI CHÚ" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource NoteTextBoxStyle}"
                                         Foreground="#374151"
                                         IsReadOnly="{Binding DataContext.IsReadOnlyMode, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>