<UserControl x:Class="GUI.Views.Pages.ClassManagement.ClassAttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             Background="Transparent" FontFamily="Segoe UI">

    <UserControl.Resources>
        <!-- COLORS -->
        <SolidColorBrush x:Key="PrimaryBlue" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="GrayText" Color="#6B7280"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E5E7EB"/>

        <!-- Status Colors -->
        <SolidColorBrush x:Key="GreenText" Color="#15803D"/>
        <SolidColorBrush x:Key="GreenBg" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="RedText" Color="#B91C1C"/>
        <SolidColorBrush x:Key="RedBg" Color="#FEE2E2"/>
        <SolidColorBrush x:Key="BlueText" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="BlueBg" Color="#DBEAFE"/>
        <SolidColorBrush x:Key="YellowText" Color="#B45309"/>
        <SolidColorBrush x:Key="YellowBg" Color="#FEF3C7"/>

        <!-- STYLE: Stat Badge (Thẻ thống kê: Có mặt: 13...) -->
        <Style x:Key="StatBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- STYLE: Radio Button Điểm danh -->
        <!-- Custom Template để RadioButton trông gọn gàng hơn -->
        <Style x:Key="AttendanceRadioButton" TargetType="RadioButton">
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bdr" Background="Transparent" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Padding="8,4">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bdr" Property="BorderThickness" Value="0"/>
                            </Trigger>
                            <!-- Màu sắc riêng cho từng loại sẽ được set trực tiếp khi sử dụng hoặc qua Trigger data -->
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Container chính -->
    <Border Background="White" CornerRadius="12" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Toolbar -->
                <RowDefinition Height="*"/>
                <!-- DataGrid -->
            </Grid.RowDefinitions>

            <!-- 1. TOOLBAR -->
            <Border Grid.Row="0" Padding="20,16" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Background="#F9FAFB" CornerRadius="12,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Date Picker + Stats -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Chọn buổi học -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                            <Border Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="4,0">
                                <ComboBox Width="180" Height="32" BorderThickness="0" Background="Transparent" SelectedIndex="0" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="📅 Hôm nay (27/11/2023)" IsSelected="True"/>
                                    <ComboBoxItem Content="✅ 25/11/2023"/>
                                    <ComboBoxItem Content="✅ 23/11/2023"/>
                                </ComboBox>
                            </Border>

                            <!-- Nút Ngày khác -->
                            <Button Margin="8,0,0,0" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="10,0" Height="34" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="+" Margin="0,0,4,0" Foreground="#6B7280"/>
                                                <TextBlock Text="Ngày khác" FontSize="12" Foreground="#6B7280"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <!-- Thống kê -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Có mặt -->
                            <Border Style="{StaticResource StatBadgeStyle}" Background="{StaticResource GreenBg}" BorderBrush="{StaticResource GreenBg}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource GreenText}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Có mặt: 13" FontSize="12" FontWeight="Bold" Foreground="{StaticResource GreenText}"/>
                                </StackPanel>
                            </Border>
                            <!-- Vắng -->
                            <Border Style="{StaticResource StatBadgeStyle}" Background="{StaticResource RedBg}" BorderBrush="{StaticResource RedBg}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource RedText}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Vắng: 1" FontSize="12" FontWeight="Bold" Foreground="{StaticResource RedText}"/>
                                </StackPanel>
                            </Border>
                            <!-- Phép -->
                            <Border Style="{StaticResource StatBadgeStyle}" Background="{StaticResource BlueBg}" BorderBrush="{StaticResource BlueBg}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource BlueText}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Phép: 1" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BlueText}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!-- Nút Chỉnh sửa -->
                        <Button Margin="0,0,8,0" Background="White" BorderBrush="{StaticResource PrimaryBlue}" BorderThickness="1" Padding="12,6" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryBlue}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Chỉnh sửa" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}"/>
                            </StackPanel>
                        </Button>

                        <!-- Nút Lưu -->
                        <Button Background="{StaticResource PrimaryBlue}" BorderThickness="0" Padding="16,6" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Lưu" FontSize="12" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. DATAGRID -->
            <DataGrid Grid.Row="1" 
                      ItemsSource="{Binding AttendanceList}" 
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False" 
                      BorderThickness="0" 
                      Background="White" 
                      RowHeight="60"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" 
                      HorizontalGridLinesBrush="#F3F4F6"
                      Padding="0,0,0,10">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#9CA3AF"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="16,0,0,10"/>
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="VerticalContentAlignment" Value="Bottom"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="16,0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <!-- STT -->
                    <DataGridTextColumn Header="STT" Binding="{Binding Index}" Width="60" Foreground="{StaticResource GrayText}"/>

                    <!-- Mã HV -->
                    <DataGridTextColumn Header="MÃ HV" Binding="{Binding StudentId}" Width="100" Foreground="{StaticResource PrimaryBlue}" FontWeight="Medium"/>

                    <!-- Họ tên -->
                    <DataGridTextColumn Header="HỌ TÊN" Binding="{Binding Name}" Width="200" FontWeight="SemiBold" Foreground="#111827"/>

                    <!-- TRẠNG THÁI (Radio Buttons Group) -->
                    <DataGridTemplateColumn Header="TRẠNG THÁI" Width="320">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">

                                    <!-- Có mặt -->
                                    <RadioButton GroupName="{Binding StudentId}" Content="Có mặt" IsChecked="{Binding IsPresent}" Style="{StaticResource AttendanceRadioButton}">
                                        <RadioButton.Resources>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource GreenBg}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="#6B7280"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource GreenText}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </RadioButton.Resources>
                                    </RadioButton>

                                    <!-- Vắng -->
                                    <RadioButton GroupName="{Binding StudentId}" Content="Vắng" IsChecked="{Binding IsAbsent}" Style="{StaticResource AttendanceRadioButton}">
                                        <RadioButton.Resources>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource RedBg}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="#6B7280"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource RedText}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </RadioButton.Resources>
                                    </RadioButton>

                                    <!-- Phép -->
                                    <RadioButton GroupName="{Binding StudentId}" Content="Phép" IsChecked="{Binding IsExcused}" Style="{StaticResource AttendanceRadioButton}">
                                        <RadioButton.Resources>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource BlueBg}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="#6B7280"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource BlueText}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </RadioButton.Resources>
                                    </RadioButton>

                                    <!-- Trễ -->
                                    <RadioButton GroupName="{Binding StudentId}" Content="Trễ" IsChecked="{Binding IsLate}" Style="{StaticResource AttendanceRadioButton}">
                                        <RadioButton.Resources>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource YellowBg}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="#6B7280"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource YellowText}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </RadioButton.Resources>
                                    </RadioButton>

                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Ghi chú -->
                    <DataGridTemplateColumn Header="GHI CHÚ" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Note}" 
                                         BorderThickness="0,0,0,1" BorderBrush="#E5E7EB" 
                                         Background="Transparent" VerticalContentAlignment="Center"
                                         Foreground="#374151"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>