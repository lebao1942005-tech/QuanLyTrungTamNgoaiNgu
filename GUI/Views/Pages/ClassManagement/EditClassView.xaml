<UserControl x:Class="GUI.Views.Pages.ClassManagement.EditClassView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Width="500" Height="Auto"
             Background="Transparent" FontFamily="Segoe UI">

    <UserControl.Resources>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#1D4ED8"/>
    </UserControl.Resources>

    <Border Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.2" Color="Gray"/>
        </Border.Effect>

        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Cập nhật thông tin lớp" FontSize="20" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center"/>
                <Button Command="{Binding CancelEditCommand}" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" 
                        FontSize="12" Width="30" Height="30" Background="Transparent" BorderThickness="0" 
                        HorizontalAlignment="Right" Cursor="Hand"/>
            </Grid>

            <!-- Form -->
            <StackPanel Grid.Row="1" VerticalAlignment="Top">
                <TextBlock Text="Tên lớp học" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#374151"/>
                <TextBox Text="{Binding EditingClassName, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" Margin="0,0,0,15"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Khóa học" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#374151"/>
                        <ComboBox ItemsSource="{Binding Courses}" 
                                  SelectedItem="{Binding EditingSelectedCourse}"
                                  DisplayMemberPath="CourseName"
                                  Padding="10,8"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Giáo viên" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#374151"/>

                        <ComboBox ItemsSource="{Binding AvailableTeachers}" 
              SelectedItem="{Binding EditingSelectedTeacher}"
              DisplayMemberPath="Name"
              Padding="10,8"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Lịch học" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#374151"/>

                        <ComboBox ItemsSource="{Binding PresetSchedules}" 
              SelectedItem="{Binding EditingSchedule, UpdateSourceTrigger=PropertyChanged}"
              Padding="10,8"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Sĩ số" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#374151"/>
                        <TextBox Text="{Binding EditingMaxStudents, UpdateSourceTrigger=PropertyChanged}" Padding="10,8"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Ngày bắt đầu" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#374151"/>
                        <DatePicker SelectedDate="{Binding EditingStartDate}" Padding="5"/>
                    </StackPanel>

                    <!-- ĐÃ SỬA: Vô hiệu hóa ngày kết thúc -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Ngày kết thúc (Tự động)" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#6B7280"/>
                        <DatePicker SelectedDate="{Binding EditingEndDate}" 
                                    Padding="5"
                                    IsEnabled="False"
                                    BorderBrush="#E5E7EB"
                                    Background="#F9FAFB"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="0,25,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Content="Hủy bỏ" Command="{Binding CancelEditCommand}" 
                        Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Foreground="#374151" 
                        Height="40" Margin="0,0,5,0" FontWeight="SemiBold" Cursor="Hand"/>

                <Button Content="Lưu thay đổi" Command="{Binding SaveEditClassCommand}" Grid.Column="1" 
                        Background="{StaticResource PrimaryBlue}" Foreground="White" BorderThickness="0" 
                        Height="40" Margin="5,0,0,0" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>