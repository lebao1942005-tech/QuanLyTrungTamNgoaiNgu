<UserControl x:Class="GUI.Views.Pages.ClassManagement.DeleteClassView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Width="450" Height="220"
             Background="Transparent" FontFamily="Segoe UI">

    <Border CornerRadius="14" Background="White">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="1" Direction="315" Color="Black" Opacity="0.14" BlurRadius="5.4"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Nút đóng -->
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,15,15,0"
                    Command="{Binding CancelDeleteCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand">
                <Path Data="M6 18L18 6M6 6L18 18" Stroke="Black" Opacity="0.34" StrokeThickness="1.5"/>
            </Button>

            <!-- Tiêu đề -->
            <TextBlock Grid.Row="0" Text="Xóa lớp học" FontSize="20" FontWeight="SemiBold" Foreground="#8A8A8A" Margin="27,35,0,0"/>

            <!-- Cảnh báo -->
            <TextBlock Grid.Row="1" Text="Bạn có chắc chắn muốn xóa lớp học này không?&#x0a;Dữ liệu điểm danh và điểm số liên quan cũng sẽ bị xóa." 
                       FontSize="13" Foreground="#6F6F6F" TextAlignment="Center" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="20,0"/>

            <!-- Nút bấm -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,30,25">
                <Button Content="Hủy bỏ" Height="37" Margin="0,0,10,0"
                        Background="Transparent" BorderThickness="0" Foreground="#6F6F6F" Cursor="Hand"
                        Command="{Binding CancelDeleteCommand}"/>

                <Button Content="Xác nhận xóa" Width="100" Height="37"
                        Background="#FEE2E2" Foreground="#DC2626" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                        Command="{Binding ConfirmDeleteClassCommand}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>