<UserControl x:Class="GUI.Views.Shared.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="240"
             Width="240"
             Background="White" 
             FontFamily="Roboto">

    <UserControl.Resources>
        <!-- Style cho RadioButton menu -->
        <Style TargetType="RadioButton" x:Key="SidebarRadioButton">
            <!-- 1. TRẠNG THÁI MẶC ĐỊNH (BÌNH THƯỜNG) -->
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Margin" Value="15,4,15,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="SidebarMenuItems"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal" 
                                        VerticalAlignment="Center" 
                                        Margin="{TemplateBinding Padding}">

                                <!-- Icon -->
                                <Image x:Name="Icon" 
                                       Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" 
                                       Width="20" Height="20" 
                                       Margin="0,0,15,0" 
                                       Opacity="0.6"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>

                                <ContentPresenter VerticalAlignment="Center" 
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EFF6FF"/>
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                                <Setter TargetName="Icon" Property="Opacity" Value="1.0"/>
                            </Trigger>

                            <!-- Selected -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#5683e9"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter TargetName="Icon" Property="Opacity" Value="1.0"/>
                            </Trigger>

                            <!-- Selected + Hover -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="#1E40AF"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock" x:Key="SectionHeader">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Margin" Value="35,25,0,10"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header / Logo -->
        <Border Grid.Row="0" Background="#EFF6FF" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="25,0,0,0">
                <TextBlock Text="Admin Center" 
                           FontSize="18" 
                           FontWeight="ExtraBold" 
                           Foreground="#1D4ED8"/>
            </StackPanel>
        </Border>

        <!-- Menu Items -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
            <StackPanel Margin="0,15,0,20">
                <TextBlock Text="QUẢN LÝ" Style="{StaticResource SectionHeader}"/>

                <!-- 1. HỌC VIÊN -->
                <RadioButton Content="Học viên" 
                             Style="{StaticResource SidebarRadioButton}" 
                             Tag="/Resources/Images/student-icon.png"
                             IsChecked="{Binding DataContext.IsStudentPage, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}"
                             Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                             CommandParameter="StudentManagement"/>

                <!-- 2. GIÁO VIÊN -->
                <RadioButton Content="Giáo viên" 
                             Style="{StaticResource SidebarRadioButton}" 
                             Tag="/Resources/Images/teacher-icon.png"
                             IsChecked="{Binding DataContext.IsTeacherPage, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}"
                             Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                             CommandParameter="TeacherManagement"/>

                <!-- 3. LỚP HỌC -->
                <RadioButton Content="Lớp học" 
                             Style="{StaticResource SidebarRadioButton}" 
                             Tag="/Resources/Images/classroom-icon.png"
                             IsChecked="{Binding DataContext.IsClassPage, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}"
                             Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                             CommandParameter="ClassManagement"/>

                <!-- 4. ĐĂNG KÝ -->
                <RadioButton Content="Đăng ký" 
                             Style="{StaticResource SidebarRadioButton}" 
                             Tag="/Resources/Images/register-icon.png"
                             IsChecked="{Binding DataContext.IsRegistrationPage, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}"
                             Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                             CommandParameter="RegistrationManagement"/>

                <!-- 5. KHÓA HỌC -->
                <RadioButton Content="Khóa học" 
                             Style="{StaticResource SidebarRadioButton}" 
                             Tag="/Resources/Images/course-icon.png"
                             IsChecked="{Binding DataContext.IsCoursePage, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}"
                             Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                             CommandParameter="CourseManagement"/>

                <!-- 6. HỌC PHÍ -->
                <RadioButton Content="Học phí" 
                             Style="{StaticResource SidebarRadioButton}" 
                             Tag="/Resources/Images/tuitionFee-icon.png"
                             IsChecked="{Binding DataContext.IsTuitionPage, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}"
                             Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                             CommandParameter="TuitionManagement"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>