<UserControl x:Class="GUI.Views.Shared.HeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="60"
             Background="#EFF6FF"
             FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Nút mở/đóng Sidebar -->
        <Button x:Name="MenuButton"
                Grid.Column="0"
                Width="48" Height="48"
                Background="Transparent"
                BorderThickness="0"
                Click="MenuButton_Click"
                VerticalAlignment="Center"
                Cursor="Hand"
                Margin="12,0,0,0">
            <Image Source="/Resources/Images/menu-icon.png"
                   Width="22" Height="22"
                   Opacity="0.75"/>
        </Button>

        <!-- Khu vực người dùng -->
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,0,20,0">

            <!-- Avatar -->
            <Grid Width="36" Height="36" Margin="0,0,10,0">
                <Ellipse Fill="#E3F2FD"/>
                <TextBlock Text="A"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#0D47A1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Tên -->
            <TextBlock Text="Admin"
                       Foreground="#0D47A1"
                       FontSize="14"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="0,0,5,0"/>

            

           
        </StackPanel>

        <!-- Line dưới cùng -->
        <Border Grid.ColumnSpan="3"
                Height="1"
                Background="#E0E0E0"
                VerticalAlignment="Bottom"/>
    </Grid>
</UserControl>
