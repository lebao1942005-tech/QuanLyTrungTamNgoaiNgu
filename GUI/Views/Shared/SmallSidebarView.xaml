<UserControl x:Class="GUI.Views.Shared.SmallSidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GUI.Views.Shared"
             Width="72"
             Background="White">

    <UserControl.Resources>
        <!-- Style nút menu dạng icon -->
        <Style x:Key="SmallSidebarButton" TargetType="RadioButton">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="SmallSidebarGroup"/>
            <!-- GroupName không còn quá quan trọng khi đã binding 2 chiều, nhưng giữ lại cũng không sao -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border"
                                Background="Transparent"
                                CornerRadius="8"
                                Width="50"
                                Height="50">
                            <Image Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                   Width="24" Height="24" 
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Opacity="0.8"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#EEF4FF"/>
                            </Trigger>
                            <!-- Selected -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#DCEAFF"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#1D4ED8"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <StackPanel VerticalAlignment="Top" Margin="0,20,0,0">

            <!-- Logo dạng nhỏ -->
            <Border Width="48" Height="48" CornerRadius="24"
                    Background="#E5EEFF" 
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20">
                <Path Data="M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z"
                      Fill="#1D4ED8"
                      Stretch="Uniform"
                      Width="24" Height="24"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- MENU ITEMS -->
            <!-- Lưu ý: Tất cả đều dùng Binding IsChecked="..." trỏ về ViewModel của Window cha -->



            <RadioButton Style="{StaticResource SmallSidebarButton}"
                         Tag="/Resources/Images/dashboard-icon.png"
                         IsChecked="{Binding DataContext.IsDashboardPage, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}"
                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                         CommandParameter="Dashboard"/>

                <!-- 1. HỌC VIÊN -->
            <RadioButton Style="{StaticResource SmallSidebarButton}"
                         Tag="/Resources/Images/student-icon.png"
                         IsChecked="{Binding DataContext.IsStudentPage, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}"
                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                         CommandParameter="StudentManagement"/>

            <!-- 2. GIÁO VIÊN -->
            <RadioButton Style="{StaticResource SmallSidebarButton}"
                         Tag="/Resources/Images/teacher-icon.png"
                         IsChecked="{Binding DataContext.IsTeacherPage, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}"
                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                         CommandParameter="TeacherManagement"/>

            <!-- 3. LỚP HỌC -->
            <RadioButton Style="{StaticResource SmallSidebarButton}"
                         Tag="/Resources/Images/classroom-icon.png"
                         IsChecked="{Binding DataContext.IsClassPage, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}"
                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                         CommandParameter="ClassManagement"/>

            <!-- 4. ĐĂNG KÝ -->
            <RadioButton Style="{StaticResource SmallSidebarButton}"
                         Tag="/Resources/Images/register-icon.png"
                         IsChecked="{Binding DataContext.IsRegistrationPage, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}"
                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                         CommandParameter="RegistrationManagement"/>

            <!-- 5. KHÓA HỌC -->
            <RadioButton Style="{StaticResource SmallSidebarButton}"
                         Tag="/Resources/Images/course-icon.png"
                         IsChecked="{Binding DataContext.IsCoursePage, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}"
                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                         CommandParameter="CourseManagement"/>

            <!-- 6. HỌC PHÍ -->
            <RadioButton Style="{StaticResource SmallSidebarButton}"
                         Tag="/Resources/Images/tuitionFee-icon.png"
                         IsChecked="{Binding DataContext.IsTuitionPage, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}"
                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                         CommandParameter="TuitionManagement"/>

        </StackPanel>

        <!-- Nút logout bên dưới -->
        <Border VerticalAlignment="Bottom" Margin="0,0,0,20">
            <RadioButton Style="{StaticResource SmallSidebarButton}"
                         Tag="/Resources/Images/logout-icon.png"
                         Command="{Binding DataContext.LogoutCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
        </Border>

    </Grid>
</UserControl>