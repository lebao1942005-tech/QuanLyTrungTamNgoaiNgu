<UserControl x:Class="GUI.Views.Shared.SmallSidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GUI.Views.Shared"
             Width="72"
             Background="White">

    <UserControl.Resources>

        <!-- Style nút menu dạng icon -->
        <Style x:Key="SmallSidebarButton" TargetType="RadioButton">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border"
                                Background="Transparent"
                                CornerRadius="8"
                                Width="50"
                                Height="50">
                            <Image Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                   Width="24" Height="24" 
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Opacity="0.8"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#EEF4FF"/>
                            </Trigger>

                            <!-- Selected -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#DCEAFF"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#1D4ED8"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="SmallSidebarGroup"/>
        </Style>

    </UserControl.Resources>


    <Grid>
        <StackPanel VerticalAlignment="Top" Margin="0,20,0,0">

            <!-- Logo dạng nhỏ -->
            <Border Width="48" Height="48" CornerRadius="24"
                    Background="#E5EEFF" 
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20">
                <Image Source="/Resources/Icons/logo_small.png"
                       Width="28" Height="28" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>

            <!-- MENU ITEMS -->
        <!--    <RadioButton 
                Style="{StaticResource SmallSidebarButton}"
                Tag="/Resources/Icons/dashboard.png"
                IsChecked="True"
                Command="{Binding NavigateCommand}"
                CommandParameter="Overview"/>
-->
            <RadioButton 
                Style="{StaticResource SmallSidebarButton}"
                Tag="/Resources/Images/student-icon.png"
                IsChecked="True"
                Command="{Binding NavigateCommand}"
                CommandParameter="StudentManagement"/>

            <RadioButton 
                Style="{StaticResource SmallSidebarButton}"
                Tag="/Resources/Images/teacher-icon.png"
                Command="{Binding NavigateCommand}"
                CommandParameter="TeacherManagement"/>

            <RadioButton 
                Style="{StaticResource SmallSidebarButton}"
                Tag="/Resources/Images/classroom-icon.png"
                Command="{Binding NavigateCommand}"
                CommandParameter="ClassManagement"/>

            <RadioButton
                Style="{StaticResource SmallSidebarButton}"
                Tag="/Resources/Images/register-icon.png"
                Command="{Binding NavigateCommand}"
                CommandParameter="RegistrationManagement"/>

            <RadioButton
                Style="{StaticResource SmallSidebarButton}"
                Tag="/Resources/Images/course-icon.png"
                Command="{Binding NavigateCommand}"
                CommandParameter="CourseManagement"/>


        </StackPanel>

        <!-- Nút logout bên dưới -->
        <Border VerticalAlignment="Bottom" Margin="0,0,0,20">
            <RadioButton
                Style="{StaticResource SmallSidebarButton}"
                Tag="/Resources/Icons/logout.png"
                Command="{Binding LogoutCommand}"/>
        </Border>

    </Grid>
</UserControl>
